# Copy to .env for local development. Never commit real secrets.

# --- Database ---
# A plain postgresql:// URL works (psql tooling and Railway inject this form);
# the app normalizes it to the psycopg driver internally.
DATABASE_URL=postgresql://comptool:comptool@localhost:5432/comptool
# COMPTOOL_DB_POOL_SIZE=10
# COMPTOOL_DB_MAX_OVERFLOW=20
# COMPTOOL_DB_POOL_RECYCLE_SECONDS=1800

# --- Server ---
PORT=8000
COMPTOOL_LOG_LEVEL=INFO
COMPTOOL_ENVIRONMENT=local

# --- Brand (default BurnSun; a self-hoster rebrands here) ---
COMPTOOL_BRAND_NAME=BurnSun

# --- Sessions (a 30-day rolling window; each request pushes the expiry out) ---
COMPTOOL_SESSION_TTL_SECONDS=2592000
# Local development is plain HTTP, and a browser silently drops a Secure cookie over it.
# Leave this ON (remove the line) anywhere with TLS.
COMPTOOL_SESSION_COOKIE_SECURE=false
# COMPTOOL_SESSION_RENEW_AFTER_SECONDS=3600
# COMPTOOL_SESSION_COOKIE_DOMAIN=

# --- Sign-in, option A: local accounts ---
# For a self-hoster with no EVE application. Signing in asks for a name and nothing else, and
# everything below it — teams, grants, comps, comments, board layouts — works exactly as it
# does under EVE SSO.
#
# Mutually exclusive with COMPTOOL_ESI_ENABLED below: set both and the app REFUSES TO START.
# One principal kind per database, so a team's owner is never half EVE character and half
# claimed name. /api/health reports which door is open as "auth".
#
# THE PASSWORDS IN THIS MODE ARE NOT HERE. A team has its own join password, set by its owner
# in the app and changeable there at any time; that is what gets somebody into a team, and it
# is stored hashed. This variable is narrower — it decides who may CREATE a team, which matters
# because signing in is open and without it a stranger could fill your instance with teams.
#
# The app refuses to start with it empty (nobody could ever make a team) or under 24 characters
# (it sits on a public URL with nothing in front of it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ...or use a passphrase of four or more words, which is easier to send to people.
#
# The one thing to know before pointing this at the internet: a claimed name is not a proof.
# Anybody who can reach the site can type a name somebody already uses and become them. What
# stops it in practice is that they must know a name to type — no anonymous route in this app
# discloses one, and claims are rate limited. If that trade is wrong for you, use EVE SSO.
# COMPTOOL_LOCAL_AUTH_ENABLED=false
# COMPTOOL_TEAM_CREATION_KEY=

# --- Sign-in, option B: EVE SSO / ESI ---
# Register an application at https://developers.eveonline.com with the callback below.
# The PKCE flow is a public client, so there is no client secret to set here.
# COMPTOOL_ESI_ENABLED=false
# COMPTOOL_ESI_CLIENT_ID=
# COMPTOOL_ESI_CALLBACK_URL=http://localhost:8000/api/v1/auth/callback
# Encrypts the stored refresh token. Comma-separated to rotate (new key first).
# COMPTOOL_ESI_TOKEN_SECRET=
# COMPTOOL_ESI_CONTACT=you@example.com
# COMPTOOL_ESI_SCOPES=publicData
# Where the callback lands. Set this when the SPA dev server serves the app instead of
# the API: `npm run dev` is on :4173 while the callback is registered on :8000, and a
# cookie set for localhost is sent to both.
# COMPTOOL_ESI_POST_LOGIN_URL=http://localhost:4173/

# --- Development sign-in (NOT for a deployed environment) ---
# Mints a session for any character a caller names, bypassing EVE entirely, so that a
# browser automation suite can get past the front page. See comptool/auth/dev.py and the
# end-to-end suite in e2e/.
#
# The app REFUSES TO START with this on unless COMPTOOL_ENVIRONMENT is one of
# ci, dev, development, docker, local, test — and unless the secret is at least 32
# characters. Every refusal from the route is a 404, so a deployment without it discloses
# nothing. /api/health reports whether it is on.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# COMPTOOL_DEV_AUTH_ENABLED=false
# COMPTOOL_DEV_AUTH_SECRET=

# --- Development name resolution (NOT for a deployed environment) ---
# Answers "which character is called X?" from this database's sign-in history instead of from
# EVE, so an offline suite can grant somebody access by name. Adding to a team is refused
# outright when the name does not resolve, so without this every grant in a deployment with
# no ESI credentials is a 503. See comptool/dev_resolve.py.
#
# Same refusal to start as the sign-in above, on the same environment allow-list, and
# /api/health reports whether it is on. No secret: it hands out nothing, and the route it
# serves already requires being a team's owner.
# COMPTOOL_DEV_RESOLVE_ENABLED=false
