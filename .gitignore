# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Vitest writes its cache to a node_modules beside wherever it was invoked from, so this
# turns up at the root as well as under web/, which has its own ignore.
node_modules/

# Playwright's own output. The suite's source is committed; what a run leaves behind is not.
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/
/e2e/tsconfig.tsbuildinfo

# OS / editor
.DS_Store
# Claude Code's working directory: a launch config that is one machine's ports and paths, and
# scratch worktrees. Nothing in here is the project's.
.claude/
